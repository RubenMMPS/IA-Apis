# Proveedor primario
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=openai/gpt-oss-20b

# Proveedor de fallback (se usa automáticamente si el primario falla con 429/503/timeout)
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_API_KEY=your_api_key_here
LLM_FALLBACK_MODEL_NAME=gemini-3.6-flash

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE

EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_MODEL_NAME=gemini-embedding-001

# LangGraph settings
LANGGRAPH_STRICT_MSGPACK=false